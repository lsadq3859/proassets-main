# Local development. Never use the example secret in production.
APP_ENV=development
FLASK_APP=app.py
SECRET_KEY=

# SQLite + private uploads (for local development)
DATABASE_PATH=proassets.db
UPLOAD_FOLDER=private_storage
MAX_CONTENT_LENGTH=524288000

# Render production: attach a persistent disk mounted at /var/data, then set:
# APP_ENV=production
# SECRET_KEY=<unique random value, at least 32 characters>
# DATABASE_PATH=/var/data/proassets.db
# UPLOAD_FOLDER=/var/data/uploads
# Production startup requires these absolute paths in every production deployment.
# On Render, they must point inside the attached persistent disk to avoid data loss.

# One-time admin creation: set these only for the bootstrap operation,
# run `python bootstrap_admin.py`, then remove all three values.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Manual contact/payment display settings (set at least one in production)
CONTACT_PHONE=
CONTACT_EMAIL=
AD_IMAGE_URL=/static/images/dhfa-banner.png
